//@version=5
indicator("Pivot BSL SSL CLEAN ONLY", overlay=true, max_lines_count=2)

pivotHigh = ta.pivothigh(high, 2, 2)
pivotLow = ta.pivotlow(low, 2, 2)

var line bslLine = na
var line sslLine = na

if not na(pivotHigh)
    if not na(bslLine)
        line.delete(bslLine)
    pivotBarHigh = bar_index - 2
    bslLine := line.new(x1=pivotBarHigh, y1=pivotHigh, x2=bar_index, y2=pivotHigh, xloc=xloc.bar_index, extend=extend.none, color=color.green, width=2)

if not na(pivotLow)
    if not na(sslLine)
        line.delete(sslLine)
    pivotBarLow = bar_index - 2
    sslLine := line.new(x1=pivotBarLow, y1=pivotLow, x2=bar_index, y2=pivotLow, xloc=xloc.bar_index, extend=extend.none, color=color.red, width=2)
