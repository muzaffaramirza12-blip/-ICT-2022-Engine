//@version=5
indicator("ICT 2022 Engine FINAL FIX", overlay=true)

// =====================
// DISPLACEMENT
// =====================
candleRange = high - low
avgRange = ta.sma(candleRange, 10)

bullDisplacement = close > open and candleRange > avgRange * 1.2
bearDisplacement = close < open and candleRange > avgRange * 1.2

// =====================
// FVG
// =====================
bullFVG = low > high[2]
bearFVG = high < low[2]

// =====================
// LIQUIDITY SWEEP
// =====================
swingHigh = ta.highest(high, 15)
swingLow = ta.lowest(low, 15)

bslSweep = high > swingHigh[1]
sslSweep = low < swingLow[1]

// =====================
// STATE
// =====================
var int state = 0
var float fvgTop = na
var float fvgBottom = na
var bool isBull = false
var int stateBars = 0
var bool firstTouchSeen = false
var bool hasLeftFvg = false

// STEP 1 — SWEEP
if state == 0
    if sslSweep
        state := 1
        isBull := true
    else if bslSweep
        state := 1
        isBull := false

// STEP 2 — DISPLACEMENT + FVG
if state == 1
    if isBull and bullDisplacement and bullFVG
        fvgTop := low
        fvgBottom := high[2]
        state := 2
        firstTouchSeen := false
        hasLeftFvg := false
    else if not isBull and bearDisplacement and bearFVG
        fvgTop := low[2]
        fvgBottom := high
        state := 2
        firstTouchSeen := false
        hasLeftFvg := false

// STEP 3 — STRICT FIRST RETURN ENTRY
inBullFVG = state == 2 and isBull and not na(fvgTop) and low <= fvgTop and high >= fvgBottom
inBearFVG = state == 2 and not isBull and not na(fvgTop) and high >= fvgBottom and low <= fvgTop
inFVG = inBullFVG or inBearFVG

if state == 2 and not hasLeftFvg
    if (isBull and low > fvgTop) or (not isBull and high < fvgBottom)
        hasLeftFvg := true

firstReturnTouch = state == 2 and hasLeftFvg and not firstTouchSeen and inFVG

longEntry = firstReturnTouch and isBull and close > open
shortEntry = firstReturnTouch and not isBull and close < open
reactionFailed = firstReturnTouch and not longEntry and not shortEntry

if firstReturnTouch
    firstTouchSeen := true

// RESET
if longEntry or shortEntry or reactionFailed
    state := 0
    fvgTop := na
    fvgBottom := na
    firstTouchSeen := false
    hasLeftFvg := false

if state == 1 or state == 2
    stateBars += 1
else
    stateBars := 0

if (state == 1 or state == 2) and stateBars >= 20
    state := 0
    fvgTop := na
    fvgBottom := na
    stateBars := 0
    firstTouchSeen := false
    hasLeftFvg := false

// SIGNALS (NO OFFSET / NO DELAY)
plotshape(longEntry, location=location.belowbar, color=color.green, style=shape.labelup, text="LONG", offset=0)
plotshape(shortEntry, location=location.abovebar, color=color.red, style=shape.labeldown, text="SHORT", offset=0)
